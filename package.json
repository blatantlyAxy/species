{
  "name": "species-game",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "test:sim": "tsx scripts/sim.ts 300 | diff - scripts/sim.snapshot.txt",
    "test:core": "tsx scripts/core.ts",
    "test:tutorial": "tsx scripts/tutorial.ts",
    "test:ui": "tsx scripts/uitest.tsx",
    "test": "npm run typecheck && npm run test:sim && npm run test:core && npm run test:tutorial && npm run test:ui",
    "release-check": "npm test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.0.2"
  },
  "description": "Species: a turn-based evolution game. Live one animal's life at a time."
}
